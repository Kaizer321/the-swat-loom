# Server-only Resend configuration (never expose these as VITE_* variables)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=The Swat Loom <onboarding@resend.dev>
# Set true for local testing; email goes only to EMAIL_TEST_TO
EMAIL_TEST_MODE=true
EMAIL_TEST_TO=your-resend-account-email@example.com
# Set to your deployed storefront URL after deployment
PUBLIC_SITE_URL=http://localhost:5173
